# ─────────────────────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / local docker-compose).
DATABASE_URL=postgres://mapkathi:mapkathi@localhost:5432/mapkathi
# Public base URL of this deployment (used for absolute links, OG tags, auth).
APP_URL=http://localhost:3000
# 'development' | 'test' | 'production'
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# AUTH (Auth.js v5)
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP — used once at seed time to create the first admin
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-on-first-login    # hashed with argon2id at seed time, never stored plain
ADMIN_NAME=Studio Owner

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT MODE — set DEPLOYMENT_MODE
#   1 = Single-tenant (self-hosted licence build — one studio)
#   2 = Multi-tenant SaaS (host/subdomain resolves the tenant)
# ─────────────────────────────────────────────────────────────────────────────
DEPLOYMENT_MODE=1

# ─────────────────────────────────────────────────────────────────────────────
# FILE STORAGE DRIVER — set STORAGE_DRIVER
#   1 = Amazon S3            (also any S3-compatible: MinIO, Wasabi, Backblaze B2)
#   2 = Google Drive         (service account; good for archival, weak for streaming)
#   3 = Local filesystem     (self-hosted VPS with a persistent disk; NOT for Vercel)
#   4 = Cloudflare R2        (S3 API, zero egress fees — best value for image-heavy sites)
#   5 = Supabase Storage     (easiest if the DB is already Supabase)
#   6 = Bunny.net Storage    (cheap CDN-attached object storage)
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=3
# Local FS driver (STORAGE_DRIVER=3)
LOCAL_STORAGE_DIR=./uploads
# Amazon S3 / S3-compatible (STORAGE_DRIVER=1)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                                  # optional; set for MinIO/Wasabi/B2
# Cloudflare R2 (STORAGE_DRIVER=4)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Supabase Storage (STORAGE_DRIVER=5)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Google Drive (STORAGE_DRIVER=2)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=           # base64 of the service-account JSON
# Bunny.net Storage (STORAGE_DRIVER=6)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=

# ─────────────────────────────────────────────────────────────────────────────
# VIDEO DELIVERY DRIVER — set VIDEO_DRIVER
#   0 = Same as STORAGE_DRIVER (serve the raw file)
#   1 = Bunny Stream         (HLS + CDN, ~$5/mo — RECOMMENDED for production)
#   2 = Cloudflare Stream
#   3 = Mux
#   4 = External embed only  (YouTube / Vimeo URLs pasted in the admin panel)
# ─────────────────────────────────────────────────────────────────────────────
VIDEO_DRIVER=0

# ─────────────────────────────────────────────────────────────────────────────
# LICENCE MODE — set LICENCE_MODE
#   1 = None (our own instance)
#   2 = One-time perpetual key (Ed25519-signed, verified offline)
#   3 = Subscription (periodic phone-home, 14-day offline grace before read-only)
# ─────────────────────────────────────────────────────────────────────────────
LICENCE_MODE=1
# Required when LICENCE_MODE=2 or 3 — base64 Ed25519 public key used to verify the licence
LICENCE_PUBLIC_KEY=
# The signed licence key issued to this deployment (LICENCE_MODE=2/3)
LICENCE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CACHE DRIVER — set CACHE_DRIVER
#   1 = In-memory LRU (default; fine for single-instance self-host)
#   2 = Redis / Upstash (required if running more than one instance)
# ─────────────────────────────────────────────────────────────────────────────
CACHE_DRIVER=1
# Required when CACHE_DRIVER=2
REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# MAIL DRIVER — set MAIL_DRIVER
#   0 = Disabled (no contact-form email, no invites — invite links shown in admin UI)
#   1 = SMTP
#   2 = Resend
# ─────────────────────────────────────────────────────────────────────────────
MAIL_DRIVER=0
